{
  "functions": {
    "api/og/share.ts": {
      "includeFiles": "node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2"
    }
  },
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/api/share-entry?token=:token"
    },
    {
      "source": "/share/:token",
      "destination": "/api/share-entry?token=:token"
    },
    {
      "source": "/portal/:token",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
