{
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/index.html"
    },
    {
      "source": "/share/:token",
      "destination": "/index.html"
    },
    {
      "source": "/portal/:token",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
