{
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/api/share-entry?token=:token"
    },
    {
      "source": "/share/:token",
      "destination": "/index.html"
    },
    {
      "source": "/portal/:token",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
